# ============================================================
# info Marhaen — Contoh konfigurasi lingkungan (copy → .env)
# JANGAN commit .env — file ini hanya templat.
# ============================================================

# --- DATABASE (PostgreSQL via Supabase) ---
# Isi dengan connection string dari Supabase Dashboard:
#   Settings → Database → Connection string
# Session pooler (port 5432) untuk prisma db push / seed / next dev.
DATABASE_URL="postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Produksi serverless (Vercel): gunakan Transaction pooler port 6543:
#   DATABASE_URL="postgresql://postgres.<ref>:<PW>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# --- SEED: kredensial Super Admin pertama (dibaca saat `prisma db seed`) ---
SEED_ADMIN_NAMA="Super Admin GMNI"
SEED_ADMIN_USERNAME="superadmin"
SEED_ADMIN_EMAIL="admin@marhaen.com"
SEED_ADMIN_PASSWORD="GantiSandiSuperAdmin123!"

# --- AUTH (Auth.js / NextAuth v4) ---
AUTH_SECRET="info-marhaen-secret-key-gmni-2026"
NEXTAUTH_SECRET="info-marhaen-secret-key-gmni-2026"
# NEXTAUTH_URL="http://localhost:3000"

# --- SUPABASE (storage/media untuk fase lanjut) ---
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."