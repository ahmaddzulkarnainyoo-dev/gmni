# ============================================================
# info Marhaen — Contoh konfigurasi lingkungan (copy → .env)
# ============================================================

# --- DATABASE (PostgreSQL) ---
# Lokal dengan docker compose up -d :
DATABASE_URL="postgresql://marhaen:marhaen_dev@localhost:5432/infomarhaen?schema=public"
# Produksi: ganti dengan connection string Neon / Vercel Postgres.

# --- SEED: kredensial Super Admin pertama (dibaca saat `prisma db seed`) ---
# HARUS diganti sebelum production. Password minimal 12 karakter.
SEED_ADMIN_NAMA="Super Admin GMNI"
SEED_ADMIN_USERNAME="superadmin"
SEED_ADMIN_EMAIL="superadmin@infomarhaen.id"
SEED_ADMIN_PASSWORD="GantiSandiSuperAdmin123!"

# --- AUTH (dipakai mulai Fase 1 — NextAuth/Auth.js) ---
# Generate dengan: npx auth secret
AUTH_SECRET=""
# NEXTAUTH_URL="http://localhost:3000"